# BeatWatch ETL - plantilla segura de configuración
# NO coloques credenciales reales en este archivo.
# En producción usa el gestor de variables/secretos de la plataforma.

MONGO_CONNECTION_STRING=mongodb://localhost:27017
DB_NAME=BeatWatchDb_Dev

ARRITMIAS_COLLECTION=Arritmias
EPISODIOS_COLLECTION=EpisodiosArritmia
ACTIVIDADES_COLLECTION=ActividadesDiarias
ESTADISTICAS_COLLECTION=EstadisticasDiarias

ETL_BATCH_INTERVAL_SECONDS=60
ETL_RUN_ON_STARTUP=true
